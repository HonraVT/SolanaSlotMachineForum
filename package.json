{
  "name": "slot_machine_solana_game",
  "version": "1.0.0",
  "description": "Bot de caça-níqueis integrado com fórum XenForo que permite jogos com criptomoedas SOL na blockchain Solana",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "api": "node scripts/localAPI.js",
    "qrcodegen": "node scripts/qrGenerator.js",

    "db:reset": "rm -f roulette.db && node -e \"import('./src/config/database.js').then(({initDatabase}) => initDatabase().then(() => console.log('Database reset complete')))\"",

    "server": "node scripts/server.js",
    "scheduler": "node scripts/scheduler.js",

    "pm2:setup": "chmod +x scripts/setup-pm2.sh && ./scripts/setup-pm2.sh",
    "pm2:start": "pm2 start ecosystem.config.json",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:restart:server": "pm2 restart slot-server",
    "pm2:restart:scheduler": "pm2 restart slot-scheduler",
    "pm2:delete": "pm2 delete all",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:logs:server": "pm2 logs slot-server",
    "pm2:logs:scheduler": "pm2 logs slot-scheduler",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",

    "logs": "tail -f logs/*.log",
    "logs:server": "tail -f logs/server*.log",
    "logs:scheduler": "tail -f logs/scheduler*.log"
  },
  "keywords": [
    "solana",
    "slot-machine",
    "cryptocurrency",
    "xenforo",
    "bot",
    "gambling",
    "blockchain"
  ],
  "author": "Your Name",
  "license": "Apache-2.0",
  "dependencies": {
    "@solana/web3.js": "^1.87.6",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "bs58": "^5.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "qr-image": "^3.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
